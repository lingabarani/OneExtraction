# OneExtraction Environment Configuration
# Copy this file to .env and update values for your environment

# ==================== APPLICATION ====================
APP_NAME=OneExtraction
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== DATABASE ====================
# Development (SQLite)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///data/processed/oneextraction.db

# Production (PostgreSQL)
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/oneextraction
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# ==================== API ====================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# API Authentication
API_KEY_SECRET=your-secret-key-here
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600

# ==================== EMAIL VALIDATION ====================
# SMTP Configuration
SMTP_TIMEOUT=10
SMTP_MAX_RETRIES=3
SMTP_BATCH_SIZE=50
SMTP_RATE_LIMIT=1  # requests per second

# Email Validation Rules
EMAIL_MIN_CONFIDENCE=40  # Minimum confidence score
EMAIL_DISPOSABLE_CHECK=true
EMAIL_ROLE_ACCOUNT_CHECK=true

# ==================== DATA SOURCES ====================
# PDL API (People Data Labs)
PDL_API_KEY=your-pdl-api-key
PDL_API_URL=https://api.peopledatalabs.com/v5

# SEC EDGAR
SEC_API_URL=https://www.sec.gov/cgi-bin/browse-edgar

# Other APIs can be configured similarly
# Add more data source configurations as needed

# ==================== CRM INTEGRATIONS ====================
# Salesforce
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_CLIENT_ID=your-client-id
SALESFORCE_CLIENT_SECRET=your-client-secret
SALESFORCE_SYNC_ENABLED=false

# HubSpot
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_SYNC_ENABLED=false

# Pipedrive
PIPEDRIVE_API_TOKEN=your-pipedrive-api-token
PIPEDRIVE_SYNC_ENABLED=false

# ==================== STORAGE ====================
# Local Storage
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_EXPORTS_PATH=data/exports

# S3 Storage (Optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=oneextraction-data
# AWS_S3_REGION=us-east-1

# GCS Storage (Optional)
# GCS_PROJECT_ID=your-project-id
# GCS_BUCKET=oneextraction-data
# GCS_CREDENTIALS_PATH=path/to/credentials.json

# ==================== MONITORING ====================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Sentry (Error Tracking)
# SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ENVIRONMENT=production

# ==================== LOGGING ====================
LOG_FORMAT=json
LOG_OUTPUT=stdout
# LOG_FILE=logs/oneextraction.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ==================== MAIL ====================
# SMTP for Notifications
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@oneextraction.io
MAIL_TO_ALERTS=admin@example.com

# ==================== CACHE ====================
# Redis Cache (Optional)
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_TTL=3600

# In-Memory Cache
CACHE_TYPE=memory
CACHE_DEFAULT_TIMEOUT=300

# ==================== WORKER/QUEUE ====================
# Celery Task Queue (Optional)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_WORKERS=4

# ==================== SECURITY ====================
# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# HTTPS/SSL
SSL_ENABLED=false
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# ==================== FEATURES ====================
FEATURE_MCP_SERVER=true
FEATURE_WEB_DASHBOARD=true
FEATURE_API=true
FEATURE_CLI=true

# ==================== DEVELOPMENT ====================
# Reload on code changes
AUTO_RELOAD=true

# Test Mode
TEST_MODE=false
TEST_DATABASE_URL=sqlite:///:memory:

# ==================== BACKUP ====================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily  # daily, weekly, monthly
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=backups/

# ==================== DEPLOYMENT ====================
# Environment
DEPLOYMENT_ENV=development

# Docker
DOCKER_REGISTRY=localhost:5000
DOCKER_IMAGE_TAG=latest

