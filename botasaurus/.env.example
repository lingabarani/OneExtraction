# Mexico B2B Ingestion Pipeline - Environment Configuration
# Copy this file to .env and configure your values

# INEGI DENUE API Configuration
# Register and obtain your free token at: https://www.inegi.org.mx/servicios/api_denue.html
DENUE_API_TOKEN=

# US Open Directories API Configuration
US_OPEN_DIRECTORIES_API_KEY=
CENSUS_DATA_API_KEY=
DATA_GOV_API_KEY=
BLS_API_KEY=
OPENFDA_API_KEY=
BEA_DATA_API_KEY=
EIA_API_KEY=
USGS_WATER_API_KEY=

# Pipeline Processing Settings
MAX_WORKERS=5
REQUEST_TIMEOUT_SECONDS=30
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0

# Privacy and Compliance Settings
# When false, sensitive personal contact fields are excluded from standard marketing exports
ENABLE_PERSONAL_CONTACT_FIELDS=false

# Storage & Cache Directories (relative to project root or absolute paths)
RAW_DATA_DIR=data/raw
OUTPUT_DIR=output
CACHE_DIR=cache
