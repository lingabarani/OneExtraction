# OneExtraction Integration Environment
# Copy this to .env and adjust as needed

# ==================== PostgreSQL ====================
FORGE_DB_HOST=localhost
FORGE_DB_PORT=5432
FORGE_DB_USER=forge
FORGE_DB_PASSWORD=oneextraction_secure_2026
FORGE_DB_NAME=oneextraction

# ==================== Dataforge ====================
FORGE_MODE=both  # 'email', 'ai', 'both'
FORGE_WORKERS=4
FORGE_CHECKPOINT_INTERVAL=100
FORGE_ROLLBACK_ON_ERROR=true

# ==================== Email Validation ====================
EMAIL_VALIDATOR_URL=http://localhost:8081/v0/check_email
EMAIL_VALIDATOR_BATCH_SIZE=50
EMAIL_VALIDATOR_DELAY_SECONDS=2

# ==================== Ollama (Optional - for AI enrichment) ====================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
ENABLE_LOCAL_AI=false  # Set to true to enable Ollama-based enrichment

# ==================== Anthropic (Optional - for audit agent) ====================
# ANTHROPIC_API_KEY=sk-xxx

# ==================== SAM.gov API (Optional) ====================
# SAM_GOV_API_KEY=your-free-key-from-api.data.gov

# ==================== SMTP Proxy (Optional - for scale) ====================
# For validating 1000+ emails/day, use SMTP proxy
# SMTP_PROXY_HOST=smtp.proxy25.com
# SMTP_PROXY_PORT=25
# SMTP_PROXY_USERNAME=your_username
# SMTP_PROXY_PASSWORD=your_password

# ==================== Output Configuration ====================
OUTPUT_DIR=output/us/api
EXPORT_FORMAT=json,csv  # comma-separated formats
EXPORT_INCLUDE_TECH=true
EXPORT_INCLUDE_HEALTH_SCORE=true

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FILE=output/us/api/logs/integration.log
